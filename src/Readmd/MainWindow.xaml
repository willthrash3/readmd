<Window x:Class="Readmd.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Readmd"
        Height="760"
        MinHeight="420"
        MinWidth="640"
        Width="1040"
        Icon="Assets/Readmd.ico"
        Background="#F5F7FA"
        Foreground="#1F2933"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="AppSurface" Color="#F5F7FA" />
        <SolidColorBrush x:Key="ChromeBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ChromeBorder" Color="#DDE3EA" />
        <SolidColorBrush x:Key="DocumentBackground" Color="#FAFBFC" />
        <SolidColorBrush x:Key="AppText" Color="#1F2933" />
        <SolidColorBrush x:Key="MutedText" Color="#64717F" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2F7D67" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#E1F1EC" />
        <SolidColorBrush x:Key="HoverBackground" Color="#ECF1F5" />
        <SolidColorBrush x:Key="PressedBackground" Color="#DDE6EC" />
        <SolidColorBrush x:Key="AccentBorder" Color="#B7D9CF" />
        <SolidColorBrush x:Key="CloseHoverBackground" Color="#E5EBF0" />
        <SolidColorBrush x:Key="ClosePressedBackground" Color="#D6E0E7" />

        <Style x:Key="ToolbarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBackground}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ChromeBorder}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PressedBackground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryToolbarButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
        </Style>

        <Style x:Key="TabCloseButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource CloseHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ClosePressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Menu}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="{DynamicResource AppText}" />
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="{DynamicResource DocumentBackground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{DynamicResource ChromeBackground}"
                                    BorderBrush="{DynamicResource ChromeBorder}"
                                    BorderThickness="0,0,0,1">
                                <TabPanel x:Name="HeaderPanel"
                                          IsItemsHost="True"
                                          Margin="14,0,14,0"
                                          Panel.ZIndex="1"
                                          KeyboardNavigation.TabIndex="1" />
                            </Border>

                            <Border Grid.Row="1"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TabItem}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="Root"
                                Margin="0,5,4,0"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                CornerRadius="6,6,0,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource AppText}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource DocumentBackground}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AppText}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource ChromeBackground}"
                BorderBrush="{DynamicResource ChromeBorder}"
                BorderThickness="0,0,0,1"
                Padding="14,10,14,9">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Border Width="30"
                        Height="30"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentBorder}"
                        BorderThickness="1"
                        CornerRadius="7">
                    <Image Source="Assets/Readmd.ico"
                           Width="18"
                           Height="18" />
                </Border>

                <TextBlock Text="Readmd"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppText}" />

                <Menu Margin="16,0,0,0"
                      VerticalAlignment="Center">
                    <MenuItem Header="_File">
                        <MenuItem Header="_Open..."
                                  InputGestureText="Ctrl+O"
                                  Click="OpenMenuItem_Click" />
                        <MenuItem Header="_Close Tab"
                                  InputGestureText="Ctrl+W"
                                  Click="CloseTabMenuItem_Click" />
                        <Separator />
                        <MenuItem Header="E_xit"
                                  Click="ExitMenuItem_Click" />
                    </MenuItem>
                </Menu>

                <Border Width="1"
                        Height="24"
                        Margin="8,0,0,0"
                        Background="{DynamicResource ChromeBorder}" />

                <Button Style="{StaticResource PrimaryToolbarButtonStyle}"
                        Width="36"
                        Padding="0"
                        Margin="8,0,0,0"
                        ToolTip="Open files"
                        Click="OpenMenuItem_Click">
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="24" Height="24">
                            <Path Data="M3 8.5 C3 7.7 3.7 7 4.5 7 L9.4 7 L11.4 9 L19.5 9 C20.3 9 21 9.7 21 10.5 L21 18.5 C21 19.3 20.3 20 19.5 20 L4.5 20 C3.7 20 3 19.3 3 18.5 Z"
                                  Fill="Transparent"
                                  Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Width="36"
                        Padding="0"
                        Margin="8,0,0,0"
                        ToolTip="Close tab"
                        Click="CloseTabMenuItem_Click">
                    <Viewbox Width="15" Height="15">
                        <Canvas Width="24" Height="24">
                            <Path Data="M6 6 L18 18 M18 6 L6 18"
                                  Stroke="{DynamicResource MutedText}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </StackPanel>
        </Border>

        <TabControl x:Name="DocumentTabs"
                    Grid.Row="1"
                    SelectionChanged="DocumentTabs_SelectionChanged" />

        <StatusBar Grid.Row="2"
                   MinHeight="30"
                   Padding="14,3"
                   Background="{DynamicResource ChromeBackground}"
                   BorderBrush="{DynamicResource ChromeBorder}"
                   BorderThickness="0,1,0,0">
            <StatusBarItem Padding="0">
                <DockPanel LastChildFill="True">
                    <Ellipse Width="7"
                             Height="7"
                             Margin="0,0,8,0"
                             Fill="{DynamicResource AccentBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText"
                               Text="Read-only"
                               Foreground="{DynamicResource MutedText}"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
